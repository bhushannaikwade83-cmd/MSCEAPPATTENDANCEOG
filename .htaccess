# MSCE Attendance App - Photo URL Redirects
# Redirect old photo URLs to new msceattendanceapp folder structure
# Maintains backward compatibility with old APK versions

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect attendance photos from old location to new location
    # Old: https://digitrixmedia.com/attendance-photos/...
    # New: https://digitrixmedia.com/msceattendanceapp/attendance-photos/...
    RewriteCond %{REQUEST_URI} ^/attendance-photos/
    RewriteRule ^attendance-photos/(.*)$ msceattendanceapp/attendance-photos/$1 [L,R=301]

    # Redirect registration photos from old location to new location
    # Old: https://digitrixmedia.com/registration-photos/...
    # New: https://digitrixmedia.com/msceattendanceapp/registration-photos/...
    RewriteCond %{REQUEST_URI} ^/registration-photos/
    RewriteRule ^registration-photos/(.*)$ msceattendanceapp/registration-photos/$1 [L,R=301]
</IfModule>

# Enable gzip compression for faster photo loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE image/jpeg
    AddOutputFilterByType DEFLATE image/png
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Cache control for photos (1 week)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 week"
    ExpiresByType image/png "access plus 1 week"
    ExpiresByType application/json "access plus 1 day"
</IfModule>
